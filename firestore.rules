rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if user is an admin
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    // Admins collection - only admins can read, super admin can write
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin() && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin';
    }
    
    // Users collection - users can read any profile (for vendor info), but only write their own
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update, delete: if isOwner(userId);
    }
    
    // Vendors collection
    match /vendors/{vendorId} {
      // Anyone can read vendor profiles (for browsing)
      allow read: if true;
      
      // Only the vendor can create their own profile
      allow create: if isAuthenticated() && request.auth.uid == vendorId;
      
      // Vendor can update their own profile, OR authenticated users can update rating/reviewCount
      allow update: if isOwner(vendorId) || 
        (isAuthenticated() && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reviewCount']));
      
      // Only the vendor can delete their own profile
      allow delete: if isOwner(vendorId);
      
      // Vendor services subcollection
      match /services/{serviceId} {
        // Anyone can read vendor services
        allow read: if true;
        
        // Only the vendor can create/update/delete their services
        allow create, update, delete: if isOwner(vendorId);
      }
    }
    
    // Services collection (vendor services)
    match /services/{serviceId} {
      // Anyone can read services
      allow read: if true;
      
      // Only authenticated vendors can create services
      allow create: if isAuthenticated();
      
      // Only the service owner can update/delete
      allow update, delete: if isAuthenticated() && 
        resource.data.vendorId == request.auth.uid;
    }
    
    // Bookings/Requests collection
    match /bookings/{bookingId} {
      // Authenticated users can read all bookings (filtered by queries)
      allow read: if isAuthenticated();
      
      // Authenticated users can create bookings
      allow create: if isAuthenticated();
      
      // Authenticated users can update bookings (for status changes)
      allow update: if isAuthenticated();
      
      // Authenticated users can delete bookings
      allow delete: if isAuthenticated();
    }
    
    // Chats collection
    match /chats/{chatId} {
      // Users can read chats they are part of
      allow read: if isAuthenticated();
      
      // Users can create chats (anyone authenticated can create)
      allow create: if isAuthenticated();
      
      // Users can update chats (for last message updates)
      allow update: if isAuthenticated();
    }
    
    // Messages collection
    match /messages/{messageId} {
      // Users can read all messages (filtered by chatId in queries)
      allow read: if isAuthenticated();
      
      // Users can create messages
      allow create: if isAuthenticated() && 
        request.resource.data.senderId == request.auth.uid;
      
      // No updates or deletes allowed
      allow update, delete: if false;
    }
    
    // Events collection
    match /events/{userId} {
      // Users can read any event (for joining by code)
      allow read: if isAuthenticated();
      
      // Users can write their own event
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // Event Messages collection (group chat)
    match /eventMessages/{eventCode}/messages/{messageId} {
      // Anyone authenticated can read messages
      allow read: if isAuthenticated();
      
      // Anyone authenticated can create messages
      allow create: if isAuthenticated();
      
      // Only message sender or event owner can delete
      allow delete: if isAuthenticated();
    }
    
    // ═══════════════════════════════════════════════════════════════
    // PAYMENT SYSTEM RULES
    // ═══════════════════════════════════════════════════════════════
    
    // Payments collection - all transactions
    match /payments/{paymentId} {
      // Authenticated users can read all payments (for admin panel)
      allow read: if isAuthenticated();
      
      // Users can create payments (as sender)
      allow create: if isAuthenticated();
      
      // Authenticated users can update payments
      allow update: if isAuthenticated();
      
      // No one can delete payments (audit trail)
      allow delete: if false;
    }
    
    // Vendor Payment Accounts - balance tracking
    match /vendorPaymentAccounts/{vendorId} {
      // Vendor can read their own account
      allow read: if isOwner(vendorId);
      
      // Admin can read all accounts
      allow read: if isAdmin();
      
      // System creates account on first payment (via admin or cloud function)
      allow create: if isAdmin() || isOwner(vendorId);
      
      // Only admin can update balances (for security)
      allow update: if isAdmin();
      
      // No deletion
      allow delete: if false;
    }
    
    // Payment Disputes
    match /disputes/{disputeId} {
      // Customer who filed or vendor involved can read
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.vendorId == request.auth.uid
      );
      
      // Admin can read all disputes
      allow read: if isAdmin();
      
      // Authenticated users can create disputes for their transactions
      allow create: if isAuthenticated() && 
        request.resource.data.customerId == request.auth.uid;
      
      // Only admin can update disputes (resolve, add notes)
      allow update: if isAdmin();
      
      // No deletion
      allow delete: if false;
    }
    
    // Refunds collection - tracks all refund transactions
    match /refunds/{refundId} {
      // Users involved can read
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.vendorId == request.auth.uid
      );
      
      // Admin can read all
      allow read: if isAdmin();
      
      // Only admin can create refunds
      allow create: if isAdmin();
      
      // Only admin can update refund status
      allow update: if isAdmin();
      
      // No deletion
      allow delete: if false;
    }
    
    // Payouts collection - vendor payouts
    match /payouts/{payoutId} {
      // Vendor can read their own payouts
      allow read: if isAuthenticated() && 
        resource.data.vendorId == request.auth.uid;
      
      // Admin can read all
      allow read: if isAdmin();
      
      // Only admin can create/update payouts
      allow create, update: if isAdmin();
      
      // No deletion
      allow delete: if false;
    }
    
    // Reviews collection - user reviews for vendors
    match /reviews/{reviewId} {
      // Anyone can read reviews (for vendor profiles)
      allow read: if true;
      
      // Authenticated users can create reviews
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      
      // Users can update their own reviews
      allow update: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
      
      // No deletion (keep review history)
      allow delete: if false;
    }
  }
}
